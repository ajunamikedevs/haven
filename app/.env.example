# Copy to .env.local for local development. Real values live in Vercel env vars, never in git.

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres on Neon. Leave empty locally to use the built-in PGlite database in .data/
DATABASE_URL=

# Email (Resend). Leave empty locally: sign-in links are printed to the server console instead
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (optional until launch)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Copy to .env.local for local development. Real values live in Vercel env vars, never in git.

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres on Neon. Leave empty locally to use the built-in PGlite database in .data/
DATABASE_URL=

# Email (Resend). Leave empty locally: sign-in links are printed to the server console instead
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (optional until launch)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (AgentaOS, merchant of record). Leave the key empty locally: a stand-in checkout at
# /dev/checkout is used instead. sk_test_… while building; sk_live_… only at launch.
AGENTAOS_API_KEY=
AGENTAOS_WEBHOOK_SECRET=
# Product (link) ids of the $5/month and $48/year plans
AGENTAOS_LINK_MONTHLY=
AGENTAOS_LINK_ANNUAL=

# Signs share links (falls back to BETTER_AUTH_SECRET)
SHARE_LINK_SECRET=

# Sent by Vercel Cron to /api/cron/daily. Generate with: openssl rand -base64 32
CRON_SECRET=
